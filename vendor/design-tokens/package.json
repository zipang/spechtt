{
	"name": "@applied-design-systems/design-tokens",
	"version": "0.1.0",
	"description": "Parse, serialize, and validate the Applied Design Systems dual-file contract (DESIGN.md + design-tokens.css), with WCAG color-contrast derivation.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zipang/applied-design-systems.git",
		"directory": "packages/design-tokens"
	},
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"main": "./src/index.ts",
